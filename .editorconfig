# EditorConfig helps maintain consistent coding styles across different editors
# See https://editorconfig.org

root = true

# All files
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown
[*.md]
trim_trailing_whitespace = false

# JSON
[*.json]
indent_size = 2

# CSS
[*.css]
indent_size = 2

# JavaScript
[*.js]
indent_size = 2
